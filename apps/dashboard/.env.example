# URL of the bot backend
# Local:      http://localhost:3001
# Production: https://your-bot-service.onrender.com
ADMIN_API_URL=

# Must match ADMIN_API_KEY in apps/bot/.env / Render bot env vars
ADMIN_API_KEY=

# Dashboard login password — must match ADMIN_PASSWORD in apps/bot/.env / Render bot env vars
ADMIN_PASSWORD=
