generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Resident {
  id                   String                 @id @default(uuid())
  telegramId           BigInt                 @unique
  telegramUsername     String?
  name                 String
  flatNumber           String
  phone                String?
  isActive             Boolean                @default(true)
  onboardingComplete   Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  vehicles             Vehicle[]
  workerRecs           WorkerRecommendation[]
  microService         MicroService?
  carpoolRoutes        CarpoolRoute[]
  carpoolRequests      CarpoolRequest[]
}

model Vehicle {
  id          String   @id @default(uuid())
  residentId  String
  number      String   @unique
  type        String
  color       String?
  model       String?
  parkingSlot String?
  createdAt   DateTime @default(now())
  resident    Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
}

model WorkerRecommendation {
  id          String    @id @default(uuid())
  residentId  String?
  name        String
  phone       String
  category    String
  tags        String[]
  rating      Int?
  notes       String?
  isActive    Boolean   @default(true)
  isBanned    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resident    Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
}

model MicroService {
  id          String    @id @default(uuid())
  residentId  String?   @unique
  name        String
  category    String
  description String?
  isPaused    Boolean   @default(false)
  isDisabled  Boolean   @default(false)
  metadata    Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resident    Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
}

model CarpoolRoute {
  id                  String    @id @default(uuid())
  residentId          String
  type                RouteType               
  recurringDays       String[]                
  oneTimeDate         DateTime?               

  destinationAddress  String
  destinationLat      Float
  destinationLng      Float
  departureTime       String                  
  morningPolyline     String                  
  morningDistanceKm   Float
  morningDurationMin  Int
  seatsAvailable      Int
  isPaused            Boolean   @default(false)

  hasReturn           Boolean   @default(false)
  returnTime          String?
  returnPolyline      String?
  returnSeatsAvailable Int?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  resident            Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  requests            CarpoolRequest[]
  rideSessions        RideSession[]
}

model CarpoolRequest {
  id              String          @id @default(uuid())
  routeId         String
  seekerId        String
  direction       Direction       
  pickupAddress   String
  pickupLat       Float
  pickupLng       Float
  distanceFromRoute Float         
  status          RequestStatus   @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime        @default(now())
  resolvedAt      DateTime?

  route           CarpoolRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  seeker          Resident        @relation(fields: [seekerId], references: [id], onDelete: Cascade)
}

model RideSession {
  id                  String      @id @default(uuid())
  routeId             String
  offererTelegramId   BigInt
  direction           Direction
  status              RideStatus  @default(ACTIVE)
  lastLat             Float?
  lastLng             Float?
  startedAt           DateTime    @default(now())
  endedAt             DateTime?

  route               CarpoolRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  members             RideSessionMember[]
}

model RideSessionMember {
  id                  String   @id @default(uuid())
  sessionId           String
  riderTelegramId     BigInt
  riderName           String
  riderFlat           String
  locationMessageId   Int       

  session             RideSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

enum RouteType {
  RECURRING
  ONE_TIME
}

enum Direction {
  MORNING
  RETURN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum RideStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String   // 'worker' | 'service'
  createdAt DateTime @default(now())

  @@unique([name, type])
}

model BotSession {
  id          String   @id @default(uuid())
  telegramId  BigInt
  sessionData Json
  updatedAt   DateTime @updatedAt

  @@unique([telegramId])
}

model Broadcast {
  id             String   @id @default(uuid())
  message        String
  sentBy         String
  sentAt         DateTime @default(now())
  recipientCount Int
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
